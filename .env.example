# Copy to .env and set real values before starting either compose stack.
# Both stacks refuse to start if these are unset, rather than falling back
# to a password published in this repository.

# Password for the unprivileged "writefreely" database user, which is the
# account the application connects as. Put this same value in config.ini.
MYSQL_PASSWORD=

# MariaDB root password. Used only for administration, never by the app.
MYSQL_ROOT_PASSWORD=

# Container timezone. Production stack only.
TZ=Etc/UTC

# Ownership the production database container adopts for its bind-mounted
# ./db directory. Defaults to nobody. Set these to your own id if you want
# to read the files from the host without sudo.
PUID=65534
PGID=65534
