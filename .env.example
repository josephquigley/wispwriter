# Copy to .env and set real values before starting either compose stack.
# Both stacks refuse to start if these are unset, rather than falling back
# to a password published in this repository.

# Password for the unprivileged "writefreely" database user, which is the
# account the application connects as. Put this same value in config.ini.
MYSQL_PASSWORD=

# MariaDB root password. Used only for administration, never by the app.
MYSQL_ROOT_PASSWORD=

# Container timezone. Both stacks.
TZ=Etc/UTC

# The user and group both containers run as, and therefore the ownership
# of everything they write: ./data and ./dbdata. Set these to your own ids
# so the bind mounts need no chown, and so you can read the files from the
# host without sudo:
#
#   echo "PUID=$(id -u)" >> .env
#   echo "PGID=$(id -g)" >> .env
#
# Both stacks. Defaults to 1000, the first user on most Linux hosts. On
# macOS, Docker Desktop remaps bind-mount ownership and these make no
# difference either way.
PUID=1000
PGID=1000

# Production stack only: the published image to run. Pin a release tag
# here instead of tracking latest.
#WRITEFREELY_IMAGE=ghcr.io/josephquigley/writefreely-wisp:v0.16.0

# Development stack only: the version string compiled into the binary.
# The build cannot read it from git in every context, so pass it here when
# you want the About page to report something specific.
#WRITEFREELY_VERSION=

# --- Backups (the `backup` compose profile) ------------------------------
#
# Nothing here is read unless you run the profile:
#
#   docker compose --profile backup run --rm backup verify
#   docker compose --profile backup up -d
#
# Database credentials are deliberately absent: the sidecar reads them from
# config.ini in the state directory, so there is one copy rather than two.
#
# RESTIC_PASSWORD is the most valuable secret in this file. Snapshots are
# encrypted with it, they contain config.ini, and config.ini can contain mail
# credentials, so whoever holds this plus read access to the bucket holds
# those too. Store it somewhere you will still have it when the server is
# gone: a backup you cannot decrypt is not a backup.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# One of these pairs, matching the repository backend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Cron expression. The default is 3am daily.
BACKUP_SCHEDULE=0 3 * * *

# Retention. Set one to 0 to keep none of that period.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_KEEP_YEARLY=2

# Optional: pinged on success, with /fail appended on failure. Works with
# healthchecks.io and Uptime Kuma.
BACKUP_HEALTHCHECK_URL=

# A restic tag, so one repository can hold several sites.
BACKUP_SITE=writefreely

# Minutes since the last successful backup before the container reports
# unhealthy. Size it to BACKUP_SCHEDULE plus grace. 11520 is 8 days, which
# suits a weekly schedule.
BACKUP_HEALTH_MAX_AGE=11520

# Production stack only: pin the sidecar by digest rather than tracking a
# branch tag.
#WRITEFREELY_BACKUP_IMAGE=ghcr.io/josephquigley/writefreely-wisp-backup@sha256:...
