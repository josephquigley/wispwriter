{{define "collection-posts"}}
{{template "header" .}}

<div class="content-container snug">
	{{if .Silenced}}
		{{template "user-silenced"}}
	{{end}}

	{{template "collection-breadcrumbs" (dict "Collection" .Collection "SingleUser" .SingleUser)}}

	<h1 id="posts-header">Posts</h1>

	{{template "collection-nav" (dict "Alias" .Alias "Path" .Path "SingleUser" .SingleUser)}}

	{{if .Flashes}}<ul class="errors">
		{{range .Flashes}}<li class="urgent">{{.}}</li>{{end}}
	</ul>{{end}}

	{{if .Posts}}
	<table class="classy export post-list">
		<thead>
			<tr>
				<th>Title</th>
				<th>Date</th>
				<th>State</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{{range .Posts}}{{template "post-row" (dict "Post" . "Alias" $.Alias "ShowBlog" $.ShowBlog "SingleUser" $.SingleUser "Collections" $.Collections)}}{{end}}
		</tbody>
	</table>
	{{else}}
	<p>This blog has no posts yet.</p>
	{{end}}

	{{if gt (len .TotalPages) 1}}
	<nav class="pager pages">
		{{range $n := .TotalPages}}<a href="/me/c/{{$.Alias}}/posts{{if ne $n 1}}?p={{$n}}{{end}}" {{if eq $.CurrentPage $n}}class="selected"{{end}}>{{$n}}</a>{{end}}
	</nav>
	{{end}}

	<div id="moving"></div>
</div>

<script src="/js/h.js"></script>
<script src="/js/postactions.js"></script>
<script src="/js/localdate.js"></script>
{{template "post-list-actions" .}}
{{template "footer" .}}
{{end}}
